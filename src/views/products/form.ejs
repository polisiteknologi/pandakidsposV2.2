<%- include('../partials/header') %>

<div class="page-header">
  <h1 class="page-title"><%= product && product.id ? 'Edit Produk' : 'Tambah Produk' %></h1>
</div>

<div class="form-card">
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="<%= product && product.id ? '/products/' + product.id : '/products' %>" method="POST">

    <div class="form-group">
      <label for="sku">Kode Produk *</label>
      <input
        type="text"
        id="sku"
        name="sku"
        value="<%= product ? product.sku || '' : '' %>"
        placeholder="Contoh: BJ-001"
        required
        autofocus
      >
    </div>

    <div class="form-group">
      <label for="name">Nama Produk *</label>
      <input
        type="text"
        id="name"
        name="name"
        value="<%= product ? product.name || '' : '' %>"
        placeholder="Contoh: Baju Anak Motif Panda"
        required
      >
    </div>

    <div class="form-group">
      <label for="category">Kategori</label>
      <input
        type="text"
        id="category"
        name="category"
        value="<%= product ? product.category || '' : '' %>"
        placeholder="Contoh: Baju Anak"
      >
    </div>

    <div class="form-group">
      <label for="base_price">Harga Modal (Rp) *</label>
      <input
        type="number"
        id="base_price"
        name="base_price"
        value="<%= product ? product.base_price || 0 : '' %>"
        placeholder="0"
        min="0"
        required
      >
    </div>

    <div class="form-group">
      <label for="stock">Stok</label>
      <input
        type="number"
        id="stock"
        name="stock"
        value="<%= product ? product.stock : 0 %>"
        placeholder="0"
        min="0"
      >
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">
        <%= product && product.id ? 'Simpan Perubahan' : 'Tambah Produk' %>
      </button>
      <a href="/products" class="btn btn-secondary">Batal</a>
    </div>

  </form>
</div>

<%- include('../partials/footer') %>
