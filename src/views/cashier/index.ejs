<%- include('../partials/header') %>

  <div class="cashier-layout">
    <!-- Kiri: Daftar Produk -->
    <div class="cashier-products">
      <div class="page-header">
        <h2 class="page-title">Daftar Produk</h2>
      </div>
      <div class="form-group">
        <input type="text" id="searchInput" placeholder="Cari produk (nama, kode)..." autocomplete="off"
          oninput="fetchProducts()">
      </div>

      <div id="productList" class="product-grid">
        <!-- Produk akan dirender di sini via JS -->
      </div>
    </div>

    <!-- Kanan: Keranjang & Pembayaran -->
    <div class="cashier-cart">
      <div class="page-header">
        <h2 class="page-title">Keranjang</h2>
      </div>
      <div id="cartList" class="cart-list">
        <!-- Keranjang dirender di sini via JS -->
      </div>

      <div class="cart-total-section">
        <div
          style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: bold; margin-bottom: 1rem;">
          <span>Total:</span>
          <span id="cartTotal" style="color: var(--color-primary);">Rp 0</span>
        </div>
        <button id="payBtn" onclick="openPaymentModal()" class="btn btn-primary"
          style="width: 100%; justify-content: center; padding: 1rem; font-size: 1.15rem; font-weight: 700;">
          BAYAR
        </button>
      </div>
    </div>
  </div>

  <!-- Modal Pembayaran -->
  <div id="paymentModal" class="modal-overlay">
    <div class="modal-content" style="max-width: 520px;">
      <h2
        style="margin-top: 0; text-align: center; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem; margin-bottom: 1.5rem;">
        Pembayaran</h2>

      <div
        style="background: var(--color-bg); padding: 1rem; border-radius: var(--radius-sm); text-align: center; margin-bottom: 1.5rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem;">
        <div>
          <span
            style="display: block; color: var(--color-text-secondary); font-size: 0.75rem; margin-bottom: 0.25rem;">Total Belanja</span>
          <strong id="modalOriginalTotal" style="font-size: 1rem; color: var(--color-text);">Rp 0</strong>
        </div>
        <div>
          <span
            style="display: block; color: var(--color-text-secondary); font-size: 0.75rem; margin-bottom: 0.25rem;">Sudah Dibayar</span>
          <strong id="modalPayableTotal" style="font-size: 1rem; color: var(--color-primary);">Rp 0</strong>
        </div>
        <div>
          <span
            style="display: block; color: var(--color-text-secondary); font-size: 0.75rem; margin-bottom: 0.25rem;">Sisa</span>
          <strong id="modalRemaining" style="font-size: 1rem; color: var(--color-danger);">Rp 0</strong>
        </div>
      </div>

      <div id="paymentList" style="margin-bottom: 1.5rem;">
        <!-- Daftar pembayaran yang sudah ditambahkan (JS) -->
      </div>

      <div id="addPaymentSection" style="margin-bottom: 1.5rem;">
        <p style="margin: 0 0 0.5rem; font-weight: bold;">Tambah Pembayaran:</p>
        <div style="display: flex; gap: 0.5rem;">
          <button onclick="openCashModal()" class="btn btn-secondary"
            style="flex: 1; font-weight: bold; padding: 0.75rem;">Tunai</button>
          <button onclick="openQrisModal()" class="btn btn-secondary"
            style="flex: 1; font-weight: bold; padding: 0.75rem;">QRIS</button>
          <button onclick="openTransferModal()" class="btn btn-secondary"
            style="flex: 1; font-weight: bold; padding: 0.75rem;">Transfer</button>
        </div>
      </div>

      <!-- Section Toleransi Pembayaran — tampil saat pembayaran sudah mencukupi -->
      <div id="toleranceSection" style="display: none; margin-bottom: 1.5rem; background: var(--color-bg); border-radius: var(--radius-sm); padding: 1rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <div>
            <span style="color: var(--color-text-secondary); font-size: 0.85rem; display: block; margin-bottom: 0.25rem;">Total Transaksi</span>
            <strong id="tolTotalTransaksi" style="font-size: 1.25rem; color: var(--color-text);">Rp 0</strong>
          </div>
          <div style="text-align: right;">
            <span style="color: var(--color-text-secondary); font-size: 0.85rem; display: block; margin-bottom: 0.25rem; font-weight: bold;">Nominal Dibayar</span>
            <input type="number" id="nominalDibayarInput"
              style="padding: 0.5rem 0.75rem; font-size: 1.25rem; font-weight: bold; text-align: right; width: 180px; border: 2px solid var(--color-primary); border-radius: var(--radius-sm);"
              placeholder="0"
              oninput="calculateTolerance()">
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; padding-top: 0.75rem; border-top: 1px solid var(--color-border);">
          <div style="display: flex; align-items: center;">
            <span style="color: var(--color-text-secondary); font-size: 0.85rem; margin-right: 0.5rem;">Selisih</span>
            <strong id="tolSelisih" style="font-size: 1.1rem; color: var(--color-text);">Rp 0</strong>
            <span id="toleranceStatus" style="font-size: 0.8rem; font-weight: bold; padding: 0.2rem 0.5rem; border-radius: 4px; margin-left: 0.5rem;"></span>
          </div>
          <span style="color: var(--color-text-secondary); font-size: 0.75rem;">Toleransi ±Rp5.000</span>
        </div>
      </div>

      <div style="display: flex; gap: 1rem;">
        <button onclick="closePaymentModal()" class="btn btn-secondary"
          style="flex: 1; justify-content: center; padding: 0.75rem;">Batal</button>
        <button id="finishBtn" onclick="finishTransaction()" class="btn btn-primary"
          style="flex: 2; justify-content: center; padding: 0.75rem;" disabled>Selesaikan Transaksi</button>
      </div>
    </div>
  </div>

  <!-- Modal Tunai -->
  <div id="cashModal" class="modal-overlay" style="display: none; z-index: 1001;">
    <div class="modal-content" style="max-width: 400px;">
      <h3 style="margin-top: 0; text-align: center;">Pembayaran Tunai</h3>
      <div style="background: var(--color-bg); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 1rem;">
          <span style="color: var(--color-text-secondary);">Sisa Pembayaran:</span>
          <strong id="cashRemaining" style="color: var(--color-primary);">Rp 0</strong>
        </div>
      </div>

      <div class="form-group">
        <label>Uang Diterima:</label>
        <input type="number" id="cashInput"
          style="padding: 1rem; font-size: 1.5rem; font-weight: bold; text-align: right;"
          oninput="calculateCashChange()">
      </div>

      <div style="display: flex; gap: 0.5rem; margin-bottom: 1.5rem;">
        <button onclick="setCashFast(0)" class="btn btn-secondary"
          style="flex: 1; font-size: 0.8rem; padding: 0.5rem; justify-content: center;">Uang Pas</button>
        <button onclick="setCashFast(50000)" class="btn btn-secondary"
          style="flex: 1; font-size: 0.8rem; padding: 0.5rem; justify-content: center;">50.000</button>
        <button onclick="setCashFast(100000)" class="btn btn-secondary"
          style="flex: 1; font-size: 0.8rem; padding: 0.5rem; justify-content: center;">100.000</button>
      </div>

      <div
        style="background: var(--color-bg); padding: 1rem; border-radius: var(--radius-sm); text-align: center; margin-bottom: 1.5rem;">
        <span
          style="display: block; color: var(--color-text-secondary); font-size: 0.875rem; margin-bottom: 0.25rem;">Kembalian</span>
        <strong id="cashChange" style="font-size: 1.5rem; color: var(--color-text);">Rp 0</strong>
      </div>

      <div style="display: flex; gap: 1rem;">
        <button onclick="closeCashModal()" class="btn btn-secondary"
          style="flex: 1; justify-content: center;">Batal</button>
        <button id="addCashBtn" onclick="addCashPayment()" class="btn btn-primary"
          style="flex: 2; justify-content: center;" disabled>Konfirmasi</button>
      </div>
    </div>
  </div>

  <!-- Modal QRIS -->
  <div id="qrisModal" class="modal-overlay" style="display: none; z-index: 1001;">
    <div class="modal-content" style="text-align: center; max-width: 380px;">
      <h3 style="margin-top: 0;">Pembayaran QRIS</h3>
      <div style="margin-bottom: 1rem;">
        Sisa Pembayaran: <strong id="qrisRemainingText"
          style="font-size: 1.25rem; display: block; margin-top: 0.25rem; color: var(--color-primary);">Rp 0</strong>
      </div>
      <div class="form-group" style="text-align: left; margin-bottom: 1rem;">
        <label>Nominal Pembayaran:</label>
        <input type="number" id="qrisInput" style="padding: 0.75rem; font-size: 1.25rem; font-weight: bold; text-align: right;">
      </div>
      <div
        style="background: white; border: 1px solid var(--color-border); padding: 1.5rem; border-radius: var(--radius-sm); margin-bottom: 1rem; display: inline-block;">
        <div style="font-size: 3.5rem; line-height: 1; color: var(--color-border);">▣</div>
        <div style="font-size: 0.8rem; color: var(--color-text-secondary); margin-top: 0.5rem;">[ BERIKAN QRIS TOKO ]
        </div>
      </div>
      <div style="display: flex; gap: 1rem;">
        <button onclick="closeQrisModal()" class="btn btn-secondary"
          style="flex: 1; justify-content: center;">Batal</button>
        <button onclick="addQrisPayment()" class="btn btn-primary"
          style="flex: 2; background: var(--color-success); border-color: var(--color-success); justify-content: center;">SUDAH
          DITERIMA</button>
      </div>
    </div>
  </div>

  <!-- Modal Transfer -->
  <div id="transferModal" class="modal-overlay" style="display: none; z-index: 1001;">
    <div class="modal-content" style="text-align: center; max-width: 380px;">
      <h3 style="margin-top: 0;">Transfer Bank</h3>
      <div style="margin-bottom: 1rem;">
        Sisa Pembayaran: <strong id="transferRemainingText"
          style="font-size: 1.25rem; display: block; margin-top: 0.25rem; color: var(--color-primary);">Rp 0</strong>
      </div>
      <div class="form-group" style="text-align: left; margin-bottom: 1rem;">
        <label>Nominal Transfer:</label>
        <input type="number" id="transferInput" style="padding: 0.75rem; font-size: 1.25rem; font-weight: bold; text-align: right;">
      </div>
      <div
        style="background: var(--color-bg); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1rem; text-align: left;">
        <div style="margin-bottom: 0.5rem;"><span
            style="color: var(--color-text-secondary); display: inline-block; width: 100px;">Bank:</span>
          <strong>BSI / ACEH</strong>
        </div>
        <div style="margin-bottom: 0.5rem;"><span
            style="color: var(--color-text-secondary); display: inline-block; width: 100px;">No Rekening:</span><br>
          <strong>
            - 04102200127432 (ACEH) <br>
            - 7199280257 (BSI)
          </strong>
        </div>
        <div><span style="color: var(--color-text-secondary); display: inline-block; width: 100px;">Atas Nama:</span>
          <strong>Ria Devira</strong>
        </div>
      </div>
      <div style="display: flex; gap: 1rem;">
        <button onclick="closeTransferModal()" class="btn btn-secondary"
          style="flex: 1; justify-content: center;">Batal</button>
        <button onclick="addTransferPayment()" class="btn btn-primary"
          style="flex: 2; background: var(--color-success); border-color: var(--color-success); justify-content: center;">SUDAH
          TRANSFER</button>
      </div>
    </div>
  </div>

  <!-- Modal Sukses Transaksi -->
  <div id="successModal" class="modal-overlay">
    <div class="modal-content" style="text-align: center; max-width: 400px;">
      <div style="font-size: 4rem; color: var(--color-success); margin-bottom: 0.5rem; line-height: 1;">✓</div>
      <h2 style="margin-top: 0; margin-bottom: 0.5rem;">Transaksi Berhasil</h2>
      <p style="color: var(--color-text-secondary); margin-bottom: 1.5rem;" id="successInvoice">-</p>

      <div
        style="background: var(--color-bg); padding: 1rem; border-radius: var(--radius-sm); margin-bottom: 1.5rem; text-align: left;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span style="color: var(--color-text-secondary);">Total:</span>
          <strong id="successTotal">Rp 0</strong>
        </div>
        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
          <span style="color: var(--color-text-secondary);">Total Dibayar:</span>
          <strong id="successCash">Rp 0</strong>
        </div>
        <div
          style="display: flex; justify-content: space-between; padding-top: 0.5rem; border-top: 1px solid var(--color-border);">
          <span style="color: var(--color-text-secondary);">Selisih:</span>
          <strong id="successChange" style="color: var(--color-text);">Rp 0</strong>
        </div>
      </div>

      <button onclick="closeSuccessModal()" class="btn btn-success"
        style="width: 100%; justify-content: center; padding: 0.75rem; background: var(--color-success); color: white; border: none;">Tutup
        & Transaksi Baru</button>
    </div>
  </div>

  <script>
    // State
    let products = [];
    let cart = []; // format: { id, name, price, stock, quantity }

    function formatRp(angka) {
      return new Intl.NumberFormat('id-ID', { style: 'currency', currency: 'IDR', minimumFractionDigits: 0 }).format(angka);
    }

    // Ambil data produk
    async function fetchProducts() {
      const search = document.getElementById('searchInput').value;
      try {
        const res = await fetch(`/cashier/api/products?search=${encodeURIComponent(search)}`);
        if (!res.ok) throw new Error('Gagal memuat produk');
        products = await res.json();
        renderProducts();
      } catch (err) {
        console.error(err);
      }
    }

    // Render daftar produk
    function renderProducts() {
      const list = document.getElementById('productList');
      list.innerHTML = '';

      if (products.length === 0) {
        list.innerHTML = '<div class="empty-state" style="grid-column: 1 / -1;"><p>Tidak ada produk yang ditemukan.</p></div>';
        return;
      }

      products.forEach(p => {
        // Hitung sisa stok
        const cartItem = cart.find(item => item.id === p.id);
        const qtyInCart = cartItem ? cartItem.quantity : 0;
        const availableStock = p.stock - qtyInCart;
        const isOutOfStock = availableStock <= 0;

        const div = document.createElement('div');
        div.className = 'product-card ' + (isOutOfStock ? 'out-of-stock' : '');

        div.innerHTML = `
      <div>
        <div style="color: var(--color-text-secondary); font-size: 0.75rem; margin-bottom: 0.25rem;">${p.sku || '-'}</div>
        <h3 style="margin: 0 0 0.5rem; font-size: 1rem; line-height: 1.3;">${p.name}</h3>
        <div style="font-weight: bold; color: var(--color-primary); font-size: 1.15rem; margin-bottom: 1rem;">${formatRp(p.price)}</div>
      </div>
      <div>
        <div style="margin-bottom: 0.75rem;">
          <span class="stock-badge ${isOutOfStock ? 'stock-empty' : availableStock <= 5 ? 'stock-low' : 'stock-ok'}">
            Stok: ${availableStock}
          </span>
        </div>
        <button 
          onclick="addToCart(${p.id})" 
          class="btn ${isOutOfStock ? 'btn-secondary' : 'btn-primary'}"
          style="width: 100%; justify-content: center;"
          ${isOutOfStock ? 'disabled' : ''}
        >
          ${isOutOfStock ? 'Habis' : 'Tambah'}
        </button>
      </div>
    `;
        list.appendChild(div);
      });
    }

    // Tambah produk ke keranjang
    function addToCart(productId) {
      const product = products.find(p => p.id === productId);
      if (!product) return;

      const cartItem = cart.find(item => item.id === productId);

      if (cartItem) {
        if (cartItem.quantity < product.stock) {
          cartItem.quantity += 1;
        } else {
          alert('Jumlah tidak boleh melebihi stok yang tersedia!');
          return;
        }
      } else {
        if (product.stock > 0) {
          cart.push({
            id: product.id,
            name: product.name,
            price: product.price,
            stock: product.stock,
            discount_percent: 0,
            quantity: 1
          });
        }
      }

      updateUI();
    }

    // Ubah jumlah item di keranjang
    function updateCartQty(productId, delta) {
      const index = cart.findIndex(item => item.id === productId);
      if (index === -1) return;

      const item = cart[index];
      const newQty = item.quantity + delta;

      if (newQty > item.stock) {
        alert('Jumlah melebihi stok yang tersedia!');
        return;
      }

      if (newQty <= 0) {
        cart.splice(index, 1);
      } else {
        item.quantity = newQty;
      }

      updateUI();
    }

    // Hapus item dari keranjang
    function removeFromCart(productId) {
      const index = cart.findIndex(item => item.id === productId);
      if (index !== -1) {
        cart.splice(index, 1);
        updateUI();
      }
    }

    // Update diskon item di keranjang
    function updateCartDiscount(productId, value) {
      const index = cart.findIndex(item => item.id === productId);
      if (index === -1) return;

      let val = parseFloat(value);
      if (isNaN(val) || val < 0) {
        val = 0;
      }

      if (val > 20) {
        alert('Diskon maksimal adalah 20%.');
        document.getElementById('discount_' + productId).value = cart[index].discount_percent;
        return;
      }

      cart[index].discount_percent = val;
      updateUI();
    }

    // Render tampilan keranjang
    function renderCart() {
      const list = document.getElementById('cartList');
      const cartTotalEl = document.getElementById('cartTotal');
      const payBtn = document.getElementById('payBtn');

      list.innerHTML = '';
      let total = 0;

      if (cart.length === 0) {
        list.innerHTML = `
      <div class="empty-state" style="padding-top: 3rem;">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">🛒</div>
        <p>Belum ada produk di keranjang</p>
      </div>
    `;
        cartTotalEl.innerText = formatRp(0);
        payBtn.disabled = true;
        payBtn.style.opacity = 0.5;
        payBtn.style.cursor = 'not-allowed';
        return;
      }

      payBtn.disabled = false;
      payBtn.style.opacity = 1;
      payBtn.style.cursor = 'pointer';

      cart.forEach((item, index) => {
        const discount = item.discount_percent || 0;
        const discountAmount = Math.round(item.price * (discount / 100));
        const finalPrice = item.price - discountAmount;
        const subtotal = finalPrice * item.quantity;
        total += subtotal;

        const div = document.createElement('div');
        div.style.borderBottom = '1px solid var(--color-border)';
        div.style.padding = '1rem 0';

        div.innerHTML = `
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
        <span style="font-weight: 600; font-size: 0.95rem;">${item.name}</span>
        <span style="font-weight: bold; color: var(--color-primary);">${formatRp(subtotal)}</span>
      </div>
      
      <div style="display: flex; flex-direction: column; gap: 0.25rem; font-size: 0.85rem; margin-bottom: 0.5rem; color: var(--color-text-secondary);">
        <div>Harga jual: ${formatRp(item.price)}</div>
        <div style="display: flex; align-items: center; gap: 0.5rem;">
          Diskon: 
          <input type="number" id="discount_${item.id}" value="${discount}" min="0" max="20" step="0.1" style="width: 60px; padding: 0.25rem;" onchange="updateCartDiscount(${item.id}, this.value)"> %
        </div>
        <div>Harga setelah diskon: <span style="color: var(--color-success); font-weight: bold;">${formatRp(finalPrice)}</span></div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center;">
        <span style="color: var(--color-text-secondary); font-size: 0.85rem;">Jumlah: ${item.quantity}</span>
        
        <div style="display: flex; align-items: center; background: var(--color-bg); border-radius: var(--radius-sm); padding: 0.15rem;">
          <button onclick="updateCartQty(${item.id}, -1)" class="btn btn-secondary" style="width: 28px; height: 28px; padding: 0; justify-content: center; font-weight: bold; border: none; background: white; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">-</button>
          
          <span style="width: 36px; text-align: center; font-weight: bold; font-size: 0.9rem;">${item.quantity}</span>
          
          <button onclick="updateCartQty(${item.id}, 1)" class="btn btn-secondary" style="width: 28px; height: 28px; padding: 0; justify-content: center; font-weight: bold; border: none; background: white; box-shadow: 0 1px 2px rgba(0,0,0,0.05);" ${item.quantity >= item.stock ? 'disabled style="opacity:0.5;"' : ''}>+</button>
          
          <button onclick="removeFromCart(${item.id})" class="btn btn-danger" style="margin-left: 0.5rem; width: 28px; height: 28px; padding: 0; justify-content: center; font-weight: bold; border: none;">✕</button>
        </div>
      </div>
    `;
        list.appendChild(div);
      });

      cartTotalEl.innerText = formatRp(total);
    }

    // Sinkronkan UI
    function updateUI() {
      renderCart();
      renderProducts();
    }

    function getTotalCartAmount() {
      return cart.reduce((sum, item) => {
        const discount = item.discount_percent || 0;
        const finalPrice = item.price - Math.round(item.price * (discount / 100));
        return sum + (finalPrice * item.quantity);
      }, 0);
    }

    // ── LOGIKA PEMBAYARAN (Sistem Toleransi ±Rp5.000) ──
    let payments = [];
    let isSubmitting = false;

    // Konstanta toleransi (harus sama dengan server-side MAX_PAYMENT_TOLERANCE)
    const MAX_PAYMENT_TOLERANCE = 5000;

    function getOriginalTotal() {
      return cart.reduce((sum, item) => {
        const discount = item.discount_percent || 0;
        const discountAmount = Math.round(item.price * (discount / 100));
        const finalPrice = item.price - discountAmount;
        return sum + (finalPrice * item.quantity);
      }, 0);
    }

    function getPaymentTotals() {
      const originalTotal = getOriginalTotal();
      // Tidak ada pembulatan — gunakan total apa adanya
      const payable_total = originalTotal;
      const totalPaid = payments.reduce((sum, p) => sum + p.amount, 0);
      const remaining = Math.max(0, payable_total - totalPaid);
      return { originalTotal, payable_total, totalPaid, remaining };
    }

    function updatePaymentUI() {
      const { originalTotal, payable_total, totalPaid, remaining } = getPaymentTotals();

      const listEl = document.getElementById('paymentList');
      listEl.innerHTML = '';

      if (payments.length > 0) {
        payments.forEach((p, index) => {
          const methodLabel = p.method === 'cash' ? 'Tunai' : p.method === 'qris' ? 'QRIS' : 'Transfer';

          const div = document.createElement('div');
          div.style.display = 'flex';
          div.style.justifyContent = 'space-between';
          div.style.alignItems = 'center';
          div.style.padding = '0.75rem';
          div.style.borderBottom = '1px solid var(--color-border)';
          div.style.marginBottom = '0.5rem';

          let extraInfo = '';
          if (p.method === 'cash') {
            extraInfo = `<div style="font-size:0.8rem; color:var(--color-text-secondary);">Diterima: ${formatRp(p.cash_received)}</div>`;
          }

          div.innerHTML = `
            <div>
              <strong>${methodLabel}</strong>
              <div style="color: var(--color-primary); font-weight: bold;">${formatRp(p.amount)}</div>
              ${extraInfo}
            </div>
            <button onclick="removePayment(${index})" class="btn btn-danger" style="padding: 0.25rem 0.5rem; font-size: 0.8rem;">Hapus</button>
          `;
          listEl.appendChild(div);
        });
      } else {
        listEl.innerHTML = '<div style="text-align:center; color:var(--color-text-secondary); font-size:0.9rem;">Belum ada pembayaran</div>';
      }

      document.getElementById('modalOriginalTotal').innerText = formatRp(originalTotal);
      document.getElementById('modalPayableTotal').innerText = formatRp(totalPaid);
      document.getElementById('modalRemaining').innerText = formatRp(remaining);

      const toleranceSection = document.getElementById('toleranceSection');

      if (remaining === 0) {
        document.getElementById('modalRemaining').style.color = 'var(--color-success)';
        document.getElementById('addPaymentSection').style.display = 'none';
        // Tampilkan section toleransi — kasir input nominal aktual
        toleranceSection.style.display = 'block';
        // Reset input toleransi
        document.getElementById('nominalDibayarInput').value = '';
        document.getElementById('toleranceStatus').innerText = '';
        document.getElementById('toleranceStatus').style.background = 'transparent';
        document.getElementById('tolSelisih').innerText = 'Rp 0';
        document.getElementById('tolTotalTransaksi').innerText = formatRp(originalTotal);
        document.getElementById('finishBtn').disabled = true; // Tunggu input nominal
      } else {
        document.getElementById('modalRemaining').style.color = 'var(--color-danger)';
        document.getElementById('addPaymentSection').style.display = 'block';
        toleranceSection.style.display = 'none';
        document.getElementById('finishBtn').disabled = true;
      }
    }

    function removePayment(index) {
      payments.splice(index, 1);
      updatePaymentUI();
    }

    function openPaymentModal() {
      if (cart.length === 0) return;
      payments = [];
      updatePaymentUI();
      document.getElementById('paymentModal').style.display = 'flex';
    }

    function closePaymentModal() {
      document.getElementById('paymentModal').style.display = 'none';
    }

    // Cash Modal Logic
    function openCashModal() {
      const { remaining } = getPaymentTotals();
      if (remaining <= 0) return;

      document.getElementById('cashRemaining').innerText = formatRp(remaining);
      document.getElementById('cashInput').value = '';
      document.getElementById('cashChange').innerText = 'Rp 0';
      document.getElementById('addCashBtn').disabled = true;

      document.getElementById('cashModal').style.display = 'flex';
      setTimeout(() => document.getElementById('cashInput').focus(), 100);
    }

    function closeCashModal() {
      document.getElementById('cashModal').style.display = 'none';
    }

    function calculateCashChange() {
      const { remaining } = getPaymentTotals();
      const cash = parseFloat(document.getElementById('cashInput').value) || 0;
      const changeEl = document.getElementById('cashChange');
      const btn = document.getElementById('addCashBtn');

      if (cash <= 0) {
        changeEl.innerText = 'Rp 0';
        changeEl.style.color = 'var(--color-danger)';
        btn.disabled = true;
        return;
      }

      if (cash >= remaining) {
        const change = cash - remaining;
        changeEl.innerText = formatRp(change);
        changeEl.style.color = 'var(--color-success)';
        btn.disabled = false;
      } else {
        changeEl.innerText = 'Rp 0 (Pembayaran Parsial)';
        changeEl.style.color = 'var(--color-text-secondary)';
        btn.disabled = false;
      }
    }

    function setCashFast(amount) {
      const { remaining } = getPaymentTotals();
      if (amount === 0) {
        document.getElementById('cashInput').value = remaining;
      } else {
        document.getElementById('cashInput').value = amount;
      }
      calculateCashChange();
    }

    function addCashPayment() {
      const { remaining } = getPaymentTotals();
      const cashReceived = parseFloat(document.getElementById('cashInput').value) || 0;
      if (cashReceived <= 0) return;

      let appliedAmount = 0;
      let changeAmount = 0;

      if (cashReceived >= remaining) {
        appliedAmount = remaining;
        changeAmount = cashReceived - remaining;
      } else {
        appliedAmount = cashReceived;
        changeAmount = 0;
      }

      payments.push({
        method: 'cash',
        amount: appliedAmount,
        cash_received: cashReceived,
        change_amount: changeAmount,
        rounding_amount: 0
      });

      closeCashModal();
      updatePaymentUI();
    }

    // QRIS Modal Logic
    function openQrisModal() {
      const { remaining } = getPaymentTotals();
      if (remaining <= 0) return;

      document.getElementById('qrisRemainingText').innerText = formatRp(remaining);
      document.getElementById('qrisInput').value = remaining;
      document.getElementById('qrisModal').style.display = 'flex';
      setTimeout(() => document.getElementById('qrisInput').focus(), 100);
    }

    function closeQrisModal() {
      document.getElementById('qrisModal').style.display = 'none';
    }

    function addQrisPayment() {
      const { remaining } = getPaymentTotals();
      const amount = parseFloat(document.getElementById('qrisInput').value) || 0;

      if (amount <= 0) {
        alert('Nominal pembayaran harus lebih besar dari 0.');
        return;
      }

      if (amount > remaining) {
        alert('Nominal pembayaran melebihi sisa pembayaran.');
        return;
      }

      payments.push({
        method: 'qris',
        amount: amount,
        reference_number: 'QRIS-' + Date.now()
      });

      closeQrisModal();
      updatePaymentUI();
    }

    // Transfer Modal Logic
    function openTransferModal() {
      const { remaining } = getPaymentTotals();
      if (remaining <= 0) return;

      document.getElementById('transferRemainingText').innerText = formatRp(remaining);
      document.getElementById('transferInput').value = remaining;
      document.getElementById('transferModal').style.display = 'flex';
      setTimeout(() => document.getElementById('transferInput').focus(), 100);
    }

    function closeTransferModal() {
      document.getElementById('transferModal').style.display = 'none';
    }

    function addTransferPayment() {
      const { remaining } = getPaymentTotals();
      const amount = parseFloat(document.getElementById('transferInput').value) || 0;

      if (amount <= 0) {
        alert('Nominal pembayaran harus lebih besar dari 0.');
        return;
      }

      if (amount > remaining) {
        alert('Nominal pembayaran melebihi sisa pembayaran.');
        return;
      }

      payments.push({
        method: 'transfer',
        amount: amount,
        reference_number: 'TRF-' + Date.now()
      });

      closeTransferModal();
      updatePaymentUI();
    }

    // Fungsi Toleransi: hitung selisih secara realtime
    function calculateTolerance() {
      const { originalTotal } = getPaymentTotals();
      const nominalInput = parseFloat(document.getElementById('nominalDibayarInput').value) || 0;
      const selisih = nominalInput - originalTotal;
      const absSelisih = Math.abs(selisih);

      document.getElementById('tolSelisih').innerText = nominalInput > 0 ? (selisih >= 0 ? '+' : '') + formatRp(selisih) : 'Rp 0';

      const statusEl = document.getElementById('toleranceStatus');
      const finishBtn = document.getElementById('finishBtn');

      if (nominalInput <= 0) {
        statusEl.innerText = '';
        statusEl.style.background = 'transparent';
        finishBtn.disabled = true;
        return;
      }

      if (selisih === 0) {
        statusEl.innerText = '• PAS';
        statusEl.style.background = '#dcfce7';
        statusEl.style.color = '#166534';
        finishBtn.disabled = false;
      } else if (absSelisih <= MAX_PAYMENT_TOLERANCE) {
        if (selisih < 0) {
          statusEl.innerText = '• KURANG (Toleransi)';
        } else {
          statusEl.innerText = '• LEBIH (Toleransi)';
        }
        statusEl.style.background = '#fef9c3';
        statusEl.style.color = '#854d0e';
        finishBtn.disabled = false;
      } else {
        statusEl.innerText = '• MELEBIHI BATAS';
        statusEl.style.background = '#fee2e2';
        statusEl.style.color = '#991b1b';
        finishBtn.disabled = true;
      }
    }

    // Selesaikan Transaksi
    async function finishTransaction() {
      if (isSubmitting) return;

      const { originalTotal, totalPaid } = getPaymentTotals();
      const nominalDibayar = parseFloat(document.getElementById('nominalDibayarInput').value) || 0;

      // Validasi client-side toleransi
      const selisih = nominalDibayar - originalTotal;
      const absSelisih = Math.abs(selisih);
      if (nominalDibayar <= 0) {
        alert('Masukkan nominal yang diterima dari pelanggan!');
        return;
      }
      if (absSelisih > MAX_PAYMENT_TOLERANCE) {
        const arah = selisih < 0 ? 'Kekurangan' : 'Kelebihan';
        alert(`${arah} pembayaran ${formatRp(absSelisih)} melebihi batas toleransi Rp 5.000. Transaksi tidak dapat diselesaikan.`);
        return;
      }

      const btn = document.getElementById('finishBtn');
      if (btn.disabled) return;

      isSubmitting = true;
      btn.disabled = true;
      btn.innerText = 'Memproses...';

      try {
        const payload = {
          items: cart.map(item => ({
            product_id: item.id,
            product_name: item.name,
            price: item.price,
            discount_percent: item.discount_percent || 0,
            quantity: item.quantity
          })),
          payments: payments,
          payment_amount: totalPaid,
          jumlah_dibayar: nominalDibayar
        };

        const res = await fetch('/cashier/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Terjadi kesalahan saat checkout');
        }

        // Tampilan sukses: sesuaikan untuk toleransi
        const selisihFinal = nominalDibayar - originalTotal;
        let jenisSel = 'PAS';
        if (selisihFinal < 0) jenisSel = 'KEKURANGAN';
        else if (selisihFinal > 0) jenisSel = 'KELEBIHAN';

        document.getElementById('successInvoice').innerText = `Nomor Transaksi: ${data.transaction.invoice_number}`;
        document.getElementById('successTotal').innerText = formatRp(originalTotal);
        document.getElementById('successCash').innerText = formatRp(nominalDibayar);
        // Tampilkan selisih di tempat "Kembalian"
        const selisihText = selisihFinal === 0 ? 'Rp 0 (Pas)'
          : selisihFinal > 0 ? `+${formatRp(selisihFinal)} (Kelebihan)`
          : `${formatRp(selisihFinal)} (Kekurangan)`;
        document.getElementById('successChange').innerText = selisihText;

        document.getElementById('successModal').style.display = 'flex';

        cart = [];
        payments = [];
        closePaymentModal();
        updateUI();
        fetchProducts();
        document.getElementById('searchInput').value = '';

      } catch (err) {
        alert(err.message);
      } finally {
        isSubmitting = false;
        btn.disabled = false;
        btn.innerText = 'Selesaikan Transaksi';
      }
    }

    function closeSuccessModal() {
      document.getElementById('successModal').style.display = 'none';
      document.getElementById('searchInput').focus();
    }

    document.addEventListener('DOMContentLoaded', () => {
      fetchProducts();
      renderCart();

      document.getElementById('searchInput').addEventListener('keypress', function (e) {
        if (e.key === 'Enter') {
          fetchProducts();
        }
      });

      document.getElementById('cashInput').addEventListener('keypress', function (e) {
        if (e.key === 'Enter' && !document.getElementById('finishBtn').disabled) {
          finishTransaction();
        }
      });
    });
  </script>

  <%- include('../partials/footer') %>