<%- include('../partials/header') %>

<div class="page-header" style="margin-bottom: 2rem;">
  <div style="display: flex; align-items: center; gap: 1rem;">
    <a href="/transactions" class="btn btn-outline" style="padding: 0.25rem 0.5rem;">&larr; Kembali</a>
    <h1 class="page-title"><%= title %></h1>
  </div>
</div>

<div class="card" style="max-width: 500px; margin: 0 auto;">
  <p style="margin-bottom: 1.5rem; color: #475569;">
    Pilih rentang tanggal untuk menghapus transaksi secara massal. Semua transaksi pada periode ini akan dihapus dan stok akan dikembalikan.
  </p>
  
  <form action="/transactions/delete-period" method="POST">
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="date_start">Tanggal Mulai <span style="color: red;">*</span></label>
      <input type="date" id="date_start" name="date_start" class="form-control" required>
    </div>
    
    <div class="form-group" style="margin-bottom: 2rem;">
      <label for="date_end">Tanggal Akhir <span style="color: red;">*</span></label>
      <input type="date" id="date_end" name="date_end" class="form-control" required>
    </div>
    
    <div style="display: flex; justify-content: flex-end; gap: 1rem;">
      <a href="/transactions" class="btn btn-secondary">Batal</a>
      <button type="submit" class="btn btn-primary">Lanjutkan</button>
    </div>
  </form>
</div>

<%- include('../partials/footer') %>
