<%- include('../partials/header') %>

<div class="page-header">
  <h2>Detail Transaksi</h2>
  <a href="/transactions" class="btn btn-outline">&larr; Kembali</a>
</div>

<div class="card p-lg mb-lg">
  <div class="grid grid-2 mb-lg">
    <div>
      <p class="text-muted mb-xs">Nomor Transaksi</p>
      <h3><%= transaction.invoice_number %></h3>
    </div>
    <div class="text-right">
      <p class="text-muted mb-xs">Tanggal</p>
      <p><strong><%= new Date(transaction.created_at).toLocaleString('id-ID') %></strong></p>
    </div>
  </div>

  <table class="table mb-lg">
    <thead>
      <tr>
        <th>Produk</th>
        <th class="text-center">Harga Jual</th>
        <th class="text-center">Diskon</th>
        <th class="text-center">Harga Akhir</th>
        <th class="text-center">Jumlah</th>
        <th class="text-right">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      <% transaction.items.forEach(item => { %>
        <tr>
          <td><%= item.product_name %></td>
          <td class="text-center">Rp <%= (item.original_price ? item.original_price : item.price).toLocaleString('id-ID') %></td>
          <td class="text-center">
            <% if (item.discount_percent > 0) { %>
              <%= item.discount_percent %>% (Rp <%= item.discount_amount.toLocaleString('id-ID') %>)
            <% } else { %>
              -
            <% } %>
          </td>
          <td class="text-center">Rp <%= item.price.toLocaleString('id-ID') %></td>
          <td class="text-center"><%= item.quantity %></td>
          <td class="text-right">Rp <%= item.subtotal.toLocaleString('id-ID') %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="grid grid-2">
    <div></div>
    <div class="checkout-summary text-right">
      <div class="summary-row">
        <span>Total Belanja:</span>
        <strong>Rp <%= (transaction.original_total || transaction.total_amount).toLocaleString('id-ID') %></strong>
      </div>
      <div class="summary-row" style="font-size: 1.1rem;">
        <span>Total Transaksi:</span>
        <strong style="color: var(--color-primary);">Rp <%= (transaction.payable_total || transaction.total_amount).toLocaleString('id-ID') %></strong>
      </div>
      
      <div style="margin: 1rem 0; text-align: left; background: #f8fafc; padding: 1rem; border-radius: 4px;">
        <h4 style="margin-top: 0; margin-bottom: 0.5rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">METODE PEMBAYARAN</h4>
        <% if (transaction.payments && transaction.payments.length > 0) { %>
          <% transaction.payments.forEach(p => { %>
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
              <span>
                <%= p.payment_method === 'cash' ? 'Tunai' : (p.payment_method === 'qris' ? 'QRIS' : 'Transfer') %>
              </span>
              <strong>Rp <%= p.amount.toLocaleString('id-ID') %></strong>
            </div>
            <% if (p.payment_method === 'cash' && p.cash_received) { %>
              <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem; font-size: 0.85rem; color: #64748b;">
                <span>Uang Diterima:</span>
                <span>Rp <%= p.cash_received.toLocaleString('id-ID') %></span>
              </div>
            <% } %>
          <% }) %>
        <% } else { %>
          <!-- Fallback untuk transaksi lama -->
          <div style="display: flex; justify-content: space-between;">
            <span>Tunai</span>
            <strong>Rp <%= transaction.payment_amount.toLocaleString('id-ID') %></strong>
          </div>
        <% } %>
        
        <div style="display: flex; justify-content: space-between; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed #cbd5e1;">
          <span>Total Dibayar:</span>
          <strong>Rp <%= transaction.payment_amount.toLocaleString('id-ID') %></strong>
        </div>
        <% if ((transaction.remaining || 0) > 0) { %>
          <div style="display: flex; justify-content: space-between; margin-top: 0.25rem; color: var(--color-danger);">
            <span>Sisa Pembayaran:</span>
            <strong>Rp <%= transaction.remaining.toLocaleString('id-ID') %></strong>
          </div>
        <% } %>
        <div style="display: flex; justify-content: space-between; margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed #cbd5e1;">
          <span>Status:</span>
          <strong style="color: <%= (transaction.status === 'paid' || !transaction.status) ? 'var(--color-success)' : 'var(--color-danger)' %>; text-transform: uppercase;"><%= (transaction.status === 'paid' || !transaction.status) ? 'LUNAS' : 'BELUM LUNAS' %></strong>
        </div>

        <!-- Informasi Toleransi Pembayaran -->
        <% const jumlahDibayar = transaction.jumlah_dibayar || transaction.payment_amount || 0; %>
        <% const selisihPembayaran = transaction.selisih_pembayaran || 0; %>
        <% const jenisSel = transaction.jenis_selisih || 'PAS'; %>
        <div style="margin-top: 0.75rem; padding-top: 0.75rem; border-top: 2px solid var(--color-border);">
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
            <span style="color: #64748b;">Nominal Dibayar:</span>
            <strong>Rp <%= jumlahDibayar.toLocaleString('id-ID') %></strong>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
            <span style="color: #64748b;">Selisih Pembayaran:</span>
            <strong style="color: <%= selisihPembayaran < 0 ? 'var(--color-danger)' : selisihPembayaran > 0 ? 'var(--color-success)' : 'var(--color-text)' %>">
              <%= selisihPembayaran >= 0 ? '+' : '' %>Rp <%= selisihPembayaran.toLocaleString('id-ID') %>
            </strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: #64748b;">Status Selisih:</span>
            <strong style="color: <%= jenisSel === 'PAS' ? 'var(--color-success)' : jenisSel === 'KEKURANGAN' ? 'var(--color-danger)' : 'var(--color-warning, #f59e0b)' %>">
              <%= jenisSel === 'PAS' ? 'Pas' : jenisSel === 'KEKURANGAN' ? 'Kekurangan' : 'Kelebihan' %>
            </strong>
          </div>
        </div>
      </div>
      
      <div style="margin-top: 1rem; border-top: 2px solid var(--color-border); padding-top: 1rem; text-align: left;">
        <h4 style="margin: 0 0 0.5rem 0;">LABA</h4>
        <strong style="font-size: 1.25rem; color: var(--color-success);">Rp <%= transaction.total_profit.toLocaleString('id-ID') %></strong>
      </div>
    </div>
  </div>
</div>

<% if (user && user.role === 'ADMIN') { %>
  <div style="text-align: right; margin-top: 1rem;">
    <button onclick="openDeleteModal()" class="btn btn-danger">Hapus Transaksi</button>
  </div>

  <!-- Modal Konfirmasi Hapus -->
  <div id="deleteModal" class="modal-overlay" style="display: none; align-items: center; justify-content: center; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 1000;">
    <div class="modal-content" style="background: white; padding: 2rem; border-radius: 0.5rem; max-width: 400px; width: 100%;">
      <h3 style="color: #ef4444; margin-top: 0; text-align: center;">PERINGATAN</h3>
      <p style="text-align: center;">Anda akan menghapus transaksi:</p>
      <div style="background: #f8fafc; padding: 1rem; border-radius: 4px; margin: 1rem 0; text-align: center;">
        <strong style="font-size: 1.25rem;"><%= transaction.invoice_number %></strong><br>
        <span style="color: #64748b; font-size: 0.85rem;">Tanggal: <%= new Date(transaction.created_at).toLocaleString('id-ID') %></span><br>
        <span style="color: #0f172a; font-weight: bold;">Total: Rp <%= transaction.total_amount.toLocaleString('id-ID') %></span>
      </div>
      <p style="font-size: 0.9rem; color: #475569; text-align: center;">
        Data transaksi akan dihapus dari riwayat dan laporan.<br>
        Stok produk akan dikembalikan sesuai jumlah barang pada transaksi.<br><br>
        <strong style="color: #b91c1c;">Tindakan ini tidak dapat dibatalkan tanpa menggunakan backup.</strong>
      </p>
      <p style="text-align: center; margin-bottom: 1.5rem; font-weight: bold;">Apakah Anda yakin?</p>
      
      <div style="display: flex; gap: 1rem;">
        <button onclick="closeDeleteModal()" class="btn btn-secondary" style="flex: 1; justify-content: center;">Batal</button>
        <form action="/transactions/<%= transaction.id %>/delete" method="POST" style="flex: 1; display: flex;">
          <button type="submit" class="btn btn-danger" style="width: 100%; justify-content: center;">Hapus Transaksi</button>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openDeleteModal() {
      document.getElementById('deleteModal').style.display = 'flex';
    }
    function closeDeleteModal() {
      document.getElementById('deleteModal').style.display = 'none';
    }
  </script>
<% } %>

<%- include('../partials/footer') %>
